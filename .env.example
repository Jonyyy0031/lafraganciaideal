# Local development environment. `just bootstrap` copies this file to .env if it is missing
# and never overwrites an existing .env. Development credentials only — never real secrets.

# PostgreSQL (database for the app + a separate one for integration tests)
POSTGRES_USER=fragancia
POSTGRES_PASSWORD=fragancia-dev
POSTGRES_DB=fragancia
POSTGRES_TEST_DB=fragancia_test
POSTGRES_PORT=5433

# Valkey (job queues)
VALKEY_PORT=6380

# S3-compatible storage (RustFS) for product photos
S3_ACCESS_KEY=fragancia
S3_SECRET_KEY=fragancia-dev
S3_BUCKET=fragancia-media
S3_PORT=9100
S3_CONSOLE_PORT=9101

# Mailpit (captures outgoing email)
SMTP_PORT=1026
MAILPIT_UI_PORT=8026
