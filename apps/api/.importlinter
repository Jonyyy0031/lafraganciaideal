; Architecture rules, checked by `just arch` and CI. See docs/architecture.md.
; If a rule gets in your way, do not work around it: explain why and propose an ADR.
[importlinter]
root_package = fragancia_api
include_external_packages = True

[importlinter:contract:kernel-is-pure]
name = The shared kernel uses only the standard library
type = forbidden
source_modules =
    fragancia_api.shared.kernel
forbidden_modules =
    fastapi
    starlette
    pydantic
    pydantic_settings
    sqlalchemy
    alembic
    psycopg
    redis
    arq
    structlog
    fragancia_api.config
    fragancia_api.container
    fragancia_api.main
    fragancia_api.modules
    fragancia_api.shared.application
    fragancia_api.shared.http
    fragancia_api.shared.infrastructure

[importlinter:contract:domain-is-pure]
name = Module domains are pure (no frameworks, no contracts, no IO)
type = forbidden
source_modules =
    fragancia_api.modules.*.domain
forbidden_modules =
    fastapi
    starlette
    pydantic
    sqlalchemy
    alembic
    psycopg
    redis
    arq
    structlog
    fragancia_api.shared.application
    fragancia_api.shared.contracts
    fragancia_api.shared.http
    fragancia_api.shared.infrastructure

[importlinter:contract:application-is-framework-free]
name = Application code does not depend on web, database or queue frameworks
type = forbidden
source_modules =
    fragancia_api.shared.application
    fragancia_api.modules.*.application
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    psycopg
    redis
    arq

[importlinter:contract:shared-layers]
name = Shared layers point inwards (http | infrastructure -> application -> kernel)
type = layers
layers =
    fragancia_api.shared.http | fragancia_api.shared.infrastructure
    fragancia_api.shared.application
    fragancia_api.shared.kernel | fragancia_api.shared.contracts

[importlinter:contract:composition-root]
name = Only the entrypoints know the composition root
type = forbidden
source_modules =
    fragancia_api.shared
    fragancia_api.modules
forbidden_modules =
    fragancia_api.container
    fragancia_api.main

[importlinter:contract:module-layers]
name = Module layers point inwards (module -> http | infrastructure -> application -> contracts | domain)
type = layers
containers =
    fragancia_api.modules.catalog
layers =
    module
    http | infrastructure
    application
    contracts | domain

[importlinter:contract:modules-independent]
name = Modules do not import each other (cross-module calls go through ports + adapters)
type = independence
modules =
    fragancia_api.modules.*
