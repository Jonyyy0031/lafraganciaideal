# API settings for local development. `just bootstrap` copies this file to apps/api/.env if
# it is missing and never overwrites it. Development values only — never real secrets.

APP_ENV=development
API_PORT=8100
LOG_LEVEL=INFO

# Match the defaults in infra/docker/compose.yaml. The test database name must end in _test.
DATABASE_URL=postgresql+psycopg://fragancia:fragancia-dev@127.0.0.1:5433/fragancia
DATABASE_URL_TEST=postgresql+psycopg://fragancia:fragancia-dev@127.0.0.1:5433/fragancia_test
VALKEY_URL=redis://127.0.0.1:6380/0

# Comma-separated origins allowed by CORS (the Angular dev server, phase 3).
CORS_ORIGINS=http://localhost:4200

# Largest JSON, form or text request body, in bytes (default shown). Larger bodies get 413
# before any route runs. Binary uploads use the larger of the photo and import limits.
# REQUEST_MAX_BYTES=1048576

# Back-office sessions and login throttle (development values; revisit before production).
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
LOGIN_EMAIL_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=50
LOGIN_WINDOW_MINUTES=15

# Secret behind the private order links (at least 32 characters, required in production).
# Never rotate it: rotating breaks every private link already sent to customers.
# Unset outside production, the API uses a fixed development value.
ORDER_LINK_SECRET=

# Mercado Pago (payments). In development use the TEST- credentials of your own test
# application; never commit a real token. Required in production, where the sandbox must be off.
# Point MERCADOPAGO_API_URL at a local fake to try the checkout without an account.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_API_URL=https://api.mercadopago.com
MERCADOPAGO_SANDBOX=true

# Account emails: invitation and password-reset links (identity). Mailpit in development:
# http://127.0.0.1:8026 shows every message.
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
ADMIN_WEB_URL=http://localhost:4200
# The customer emails link to {STOREFRONT_URL}/pedido#token=... (no trailing slash).
STOREFRONT_URL=http://localhost:4200
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_STARTTLS=false
MAIL_FROM="La Fragancia Ideal <no-reply@lafraganciaideal.test>"

# S3-compatible storage for product photos (RustFS in development; bucket created by bootstrap).
S3_ENDPOINT_URL=http://127.0.0.1:9100
S3_ACCESS_KEY=fragancia
S3_SECRET_KEY=fragancia-dev
S3_BUCKET=fragancia-media
# Public prefix the storefront loads photos from (a CDN in production).
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9100/fragancia-media

# Catalog import from an .xlsx file (defaults shown). The worker validates each upload; an
# unconfirmed import expires after the TTL. Allowing private image hosts is for tests and
# local QA only (it lets the import download from 127.0.0.1 and private networks).
# CATALOG_IMPORT_MAX_BYTES=5242880
# CATALOG_IMPORT_MAX_ROWS=2000
# CATALOG_IMPORT_TTL_MINUTES=60
# CATALOG_IMPORT_IMAGE_ALLOW_PRIVATE_HOSTS=false
