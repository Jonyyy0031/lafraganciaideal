# API settings for local development. `just bootstrap` copies this file to apps/api/.env if
# it is missing and never overwrites it. Development values only — never real secrets.

APP_ENV=development
API_PORT=8100
LOG_LEVEL=INFO

# Must match the root .env (docker compose). The test database name must end in _test.
DATABASE_URL=postgresql+psycopg://fragancia:fragancia-dev@127.0.0.1:5433/fragancia
DATABASE_URL_TEST=postgresql+psycopg://fragancia:fragancia-dev@127.0.0.1:5433/fragancia_test
VALKEY_URL=redis://127.0.0.1:6380/0

# Comma-separated origins allowed by CORS (the Angular dev server, phase 3).
CORS_ORIGINS=http://localhost:4200

# DEVELOPMENT ONLY admin token: send `Authorization: Bearer <token>` to /api/v1/admin/*.
# The API refuses to start in production while this is set.
ADMIN_DEV_TOKEN=dev-admin-token
